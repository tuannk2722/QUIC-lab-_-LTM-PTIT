        "resource_count": {
          "type": "integer",
          "minimum": 1
        },
        "resource_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "chunk_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "delay_each_way_ms": {
          "type": "number",
          "minimum": 0
        },
        "loss_downstream_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "loss_upstream_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "rate_mbps": {
          "type": "number",
          "minimum": 0
        },
        "netem_seed": {
          "type": [
            "integer",
            "null"
