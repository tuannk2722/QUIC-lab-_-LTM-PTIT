        "tls_resumed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attempted_0rtt": {
          "type": "boolean"
        },
        "used_0rtt": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "early_rejected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fallback_count": {
          "type": "integer",
          "minimum": 0
