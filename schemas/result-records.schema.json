        "handshake_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "connect_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "early_ready_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ttfa_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transfer_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "number",
          "minimum": 0
