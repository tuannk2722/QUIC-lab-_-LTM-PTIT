      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 0,
          "const": 1
        },
        "experiment_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "warmup",
            "measured",
            "evidence"
          ]
        },
        "repeat_index": {
          "type": "integer",
          "minimum": 0
        },
        "pair_id": {
          "type": "string"
        },
        "order_index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "scenario": {
          "type": "string"
        },
        "transport": {
          "type": "string",
          "enum": [
            "tcp",
            "quic"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "cold",
            "resumed",
            "early"
          ]
        },
        "trace_mode": {
          "type": "string",
          "enum": [
            "performance",
            "evidence"
          ]
        },
        "network_profile": {
          "type": "string",
          "enum": [
            "ingress-ifb",
            "egress-demo",
            "loopback-test"
          ]
