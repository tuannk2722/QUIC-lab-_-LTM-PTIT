test "$(/home/tuannk/projects/QUIC-lab-_-LTM-PTIT/.tools/go1.27.1/bin/go version | awk '{print $3}')" = "go1.27.1" || { echo 'Expected Go 1.27.1; see README.md' >&2; exit 3; }
mkdir -p bin
/home/tuannk/projects/QUIC-lab-_-LTM-PTIT/.tools/go1.27.1/bin/go build -mod=readonly -trimpath -ldflags '-X quic-performance-lab/internal/cli.Build=6adbcd6' -o bin/server ./cmd/server
/home/tuannk/projects/QUIC-lab-_-LTM-PTIT/.tools/go1.27.1/bin/go build -mod=readonly -trimpath -ldflags '-X quic-performance-lab/internal/cli.Build=6adbcd6' -o bin/client ./cmd/client
/home/tuannk/projects/QUIC-lab-_-LTM-PTIT/.tools/go1.27.1/bin/go build -mod=readonly -trimpath -ldflags '-X quic-performance-lab/internal/cli.Build=6adbcd6' -o bin/bench ./cmd/bench
bench_args=(); \
	if [[ -n $RUNS ]]; then bench_args+=(--runs="$RUNS"); fi; \
	if [[ -n $WARMUPS ]]; then bench_args+=(--warmups="$WARMUPS"); fi; \
	if [[ -n $SEED ]]; then bench_args+=(--seed="$SEED"); fi; \
	if [[ $NETEM_SEED == none ]]; then bench_args+=(--disable-netem-seed); \
	elif [[ $NETEM_SEED != default ]]; then echo 'Use SEED for schedule seed or NETEM_SEED=none explicitly.' >&2; exit 2; fi; \
	sudo bash scripts/bench.sh "${bench_args[@]}"
test -n "$RESULTS" || { echo 'Use make analyze RESULTS=results/<experiment>' >&2; exit 2; }
python3 analysis/validate.py "$RESULTS"
python3 analysis/summarize.py "$RESULTS"
python3 analysis/plot.py "$RESULTS"
